# ===== build output =====
/target/

# ===== test fixtures =====
# Numeric baseline dumped from the Python reference.  `tests/golden.rs` reads
# it by default ($CTC_GOLDEN_DIR), so it is needed to run `cargo test` — large
# (575 MB) and reproducible from the reference, hence not tracked.
/golden/

# ===== GPU debug dumps =====
# Raw device buffers from a failed run.  Regenerated on demand; only worth
# keeping while diagnosing a specific crash.
/gpu_debug/

